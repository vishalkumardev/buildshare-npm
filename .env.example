# BuildShare CLI Configuration
# API Configuration
BUILDSHARE_API_URL=https://api.buildshare.io
BUILDSHARE_API_VERSION=v1

# Debug Mode
BUILDSHARE_DEBUG=false
BUILDSHARE_VERBOSE=false

# Upload Configuration
BUILDSHARE_CHUNK_SIZE=5242880
BUILDSHARE_MAX_RETRIES=3
BUILDSHARE_PARALLEL_CHUNKS=3
BUILDSHARE_UPLOAD_TIMEOUT=300000

# CI/CD Mode
BUILDSHARE_CI=false
BUILDSHARE_API_TOKEN=
